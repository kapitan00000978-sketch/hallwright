{
  "mcpServers": {
    "hallwright": {
      "command": "python",
      "args": [
        "c:/Users/user/Videos/New folder (3)/mcp/server.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "threejs-devtools": {
      "command": "npx.exe",
      "args": [
        "-y",
        "threejs-devtools-mcp"
      ]
    }
  }
}
